# --- Agent LLM (Gemini via API compatible OpenAI) ---
# Crée une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Ticketmaster ---
# Clé sur https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# --- Données ---
# 1 = si Ticketmaster est indisponible ou vide, utiliser les concerts de démonstration
#     (toujours signalés comme tels dans les réponses)
DEMO_FALLBACK=1
# 1 = forcer les données de démonstration, sans appeler Ticketmaster
MODE_DEMO=0

# --- Spotify ---
# Dashboard : https://developer.spotify.com/dashboard
# La REDIRECT_URI doit etre identique, au caractere pres, a celle du dashboard.
# Spotify refuse localhost : utiliser l'IP loopback 127.0.0.1 en local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:5000/callback
# En ligne (Render) : https://ton-service.onrender.com/callback

# --- Flask ---
FLASK_SECRET=change-moi-en-local
PORT=5000
# HOST=0.0.0.0 en production ; 127.0.0.1 en local
HOST=127.0.0.1

# --- Ollama (optionnel, si LLM_PROVIDER=ollama) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
